# Copie este arquivo para .env.local e preencha os valores.
# NUNCA versione .env.local (já está no .gitignore).

# --- Supabase ---------------------------------------------------------
# URL e chaves do projeto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de service role: NUNCA exposta ao browser. Usada só em rotas
# server-side e no worker de jobs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Providers de IA ----------------------------------------------------
# Regra do projeto: nenhuma API paga. Texto/copy segue como placeholder até
# existir um provider de texto genuinamente sem custo.

# Kairogen (imagem e vídeo, via MCP com OAuth device flow — não é uma
# API key simples; free tier com crédito limitado). Ver ENVIRONMENT.md.
KAIROGEN_CLIENT_ID=
KAIROGEN_REFRESH_TOKEN=

# --- Edição/montagem de vídeo (Fase 6, ainda não resolvido) --------------
# HyperFrames não é uma API — ver ARCHITECTURE.md.

# --- Google Sheets (Análise de Produtos) ---------------------------------
# OAuth "Aplicativo da Web" (não é API key) — autorizar visitando
# /api/auth/google-sheets/start logado no app. Refresh token fica no banco
# (provider_tokens), não aqui. Ver ENVIRONMENT.md.
# Múltiplas fontes de planilha — ver src/lib/sheets-config.ts (SHEET_SOURCES).
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SPREADSHEET_ID_SHORTLIST=
GOOGLE_SHEETS_SPREADSHEET_ID_VENDAS=

# --- Aplicação -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
